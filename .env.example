NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Notifs staff tracker (pas l'email patient — celui-ci part côté questionnaires)
RESEND_API_KEY=your_resend_api_key_here
# Ops Resend / MCP / tags : docs/ops/RESEND.md

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pont questionnaires (optionnel — prod ci-dessous)
# TRACKER_SYNC_SERVICE_TOKEN=
# QUESTIONNAIRES_API_BASE=https://questionnaire.franchir.eu/api/integrations/tracker
# QUESTIONNAIRES_PORTAL_URL=https://questionnaire.franchir.eu
# TRACKER_RETURN_TOKEN=

# Lecteur MP4/m4v natif (désactivé en prod tant que non posé).
# Prod ops — poser sur Vercel Production (tracker + questionnaires) puis redeploy :
#   NEXT_PUBLIC_ENABLE_MP4_VIEWER=true
# Alias accepté : NEXT_PUBLIC_MP4_VIEWER=1
# Preview / dev : actif automatiquement (pas besoin du flag).
# NEXT_PUBLIC_ENABLE_MP4_VIEWER=true
# NEXT_PUBLIC_MP4_VIEWER=1
