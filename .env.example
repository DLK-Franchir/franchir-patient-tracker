# =============================================================================
# FRANCHIR Patient Tracker — variables d'environnement
# Projet Supabase prod : zdmeidekszdrzmjuasee — https://patients.franchir.eu
# =============================================================================
#
# Copier ce fichier vers .env.local et remplir les valeurs :
#   cp .env.example .env.local
#
# Ou synchroniser depuis Vercel (recommandé si le projet est lié) :
#   vercel env pull .env.local
#
# Ne jamais committer .env.local (secrets).

# --- Supabase (exposé au navigateur — clés publishable/anon uniquement) ---
NEXT_PUBLIC_SUPABASE_URL=https://zdmeidekszdrzmjuasee.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Clé publishable Supabase (nouveau format, optionnel si ANON_KEY présente)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# --- Supabase (serveur Next.js + scripts Node dans scripts/) ---
SUPABASE_URL=https://zdmeidekszdrzmjuasee.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# ⚠️ Jamais exposer côté client — scripts admin + API routes serveur
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=your_resend_api_key_here

# --- Pont tracker ↔ questionnaires (prod Franchir) ---
TRACKER_SYNC_SERVICE_TOKEN=your_tracker_sync_service_token
TRACKER_RETURN_TOKEN=your_tracker_return_token
QUESTIONNAIRES_API_BASE=https://questionnaire.franchir.eu/api/integrations/tracker
QUESTIONNAIRES_PORTAL_URL=https://questionnaire.franchir.eu
# Legacy multipart imagerie (~4 Mo) — laisser vide si sign-upload suffit
# QUESTIONNAIRES_IMAGING_URL=
# Défaut : {QUESTIONNAIRES_API_BASE}/imaging-sign-upload
# QUESTIONNAIRES_IMAGING_SIGN_URL=

# --- Edge Function sync-patient-to-questionnaires (Supabase Dashboard) ---
# QUESTIONNAIRES_BRIDGE_URL=https://questionnaire.franchir.eu/api/integrations/tracker/sync
# TRACKER_SYNC_SERVICE_TOKEN=  # même valeur que ci-dessus

# --- Optionnel ---
# Lecteur MP4 natif (staging / preview Vercel)
# NEXT_PUBLIC_ENABLE_MP4_VIEWER=true
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Variables injectées automatiquement par Vercel (ne pas mettre dans .env.local) ---
# VERCEL_ENV, VERCEL_URL, VERCEL_OIDC_TOKEN, TURBO_*, POSTGRES_* (intégration Supabase)
