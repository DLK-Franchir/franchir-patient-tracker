{
  "name": "franchir-patient-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:contract": "vitest run --config vitest.config.mts packages/synthesis-contract",
    "test:imaging": "vitest run --config vitest.config.mts packages/imaging",
    "test:imaging-viewer": "vitest run --config vitest.config.mts packages/imaging-viewer",
    "imaging:sync": "node scripts/sync-imaging-package.mjs",
    "imaging:check": "node scripts/sync-imaging-package.mjs --check",
    "imaging-viewer:sync": "node scripts/sync-imaging-viewer-package.mjs",
    "imaging-viewer:check": "node scripts/sync-imaging-viewer-package.mjs --check",
    "imaging:golden-tour": "node scripts/imaging-golden-tour.mjs",
    "imaging:golden-path": "node scripts/imaging-golden-tour.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "rm -rf .next node_modules",
    "reinstall": "npm run clean && npm install",
    "check": "npm run type-check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@franchir/imaging": "file:./packages/imaging",
    "@franchir/imaging-viewer": "file:./packages/imaging-viewer",
    "@franchir/synthesis-contract": "file:./packages/synthesis-contract",
    "@cornerstonejs/codec-openjpeg": "^1.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dwv": "^0.36.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "resend": "^6.7.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
